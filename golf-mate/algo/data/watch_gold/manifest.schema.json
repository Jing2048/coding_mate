{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golfmate-watch-gold-manifest-v1",
  "title": "Golf Mate Watch device-gold manifest",
  "description": "Privacy-safe catalog of real Apple Watch captures for commercial release evidence. Synthetic algorithm fixtures must not be marked ready in-repo.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "ready",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "watch-gold-manifest-v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["not_ready", "collecting", "ready"]
    },
    "ready": {
      "type": "boolean",
      "description": "Must remain false until commercial gate passes on real_device evidence."
    },
    "honesty": {
      "type": "string"
    },
    "documented_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "left_hand_not_represented",
          "right_hand_not_represented",
          "strap_loose_not_represented",
          "strap_snug_not_represented",
          "iron_not_represented",
          "wood_not_represented",
          "terrain_flat_only",
          "saturation_not_stressed",
          "series_5_compat_not_represented",
          "series_8_plus_high_rate_not_represented",
          "other"
        ]
      },
      "default": []
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "ref_block_base": {
      "type": "object",
      "required": ["present", "artifact_id", "labels"],
      "description": "When present=true, artifact_id is an opaque provenance id (no PII). External files are not required in-repo."
    },
    "ref_block_slow_mo": {
      "type": ["object", "null"],
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Required when present=true. Opaque id; no PII."
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "impact_frame_marked": { "type": "boolean" },
            "tempo_visible": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "ref_block_optical": {
      "type": ["object", "null"],
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trajectory_available": { "type": "boolean" },
            "phase_labels_available": { "type": "boolean" },
            "wrist_path_available": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "ref_block_launch_monitor": {
      "type": ["object", "null"],
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "impact_marked": { "type": "boolean" },
            "shot_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "description": "Opaque LM shot id — not a player name."
            },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "ref_block_metronome": {
      "type": ["object", "null"],
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bpm": { "type": "number", "exclusiveMinimum": 0 },
            "phase_offset_s": { "type": "number" },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "record_id",
        "subject_pseudonym",
        "device",
        "capture_mode",
        "rates",
        "handedness",
        "wrist",
        "club",
        "strap_fit",
        "terrain_lie",
        "session",
        "capture",
        "reference",
        "consent",
        "evidence_class"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque swing id within the catalog."
        },
        "subject_pseudonym": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Pseudonym only — no real names."
        },
        "device": {
          "type": "object",
          "required": ["model", "series", "watchos"],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Apple model id, e.g. Watch7,5 or Watch5,2."
            },
            "series": {
              "type": "string",
              "enum": [
                "series_5",
                "series_6",
                "series_7",
                "series_8",
                "series_9",
                "series_10",
                "ultra",
                "ultra_2",
                "se",
                "other"
              ]
            },
            "watchos": {
              "type": "string",
              "minLength": 1,
              "description": "watchOS version string, e.g. 10.5"
            }
          }
        },
        "capture_mode": {
          "type": "string",
          "enum": ["high_rate", "compat"]
        },
        "rates": {
          "type": "object",
          "required": ["accelerometer_hz", "device_motion_hz"],
          "additionalProperties": false,
          "properties": {
            "accelerometer_hz": { "type": "number", "exclusiveMinimum": 0 },
            "device_motion_hz": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "handedness": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "wrist": {
          "type": "string",
          "enum": ["lead", "trail"]
        },
        "club": {
          "type": "object",
          "required": ["class", "label"],
          "additionalProperties": false,
          "properties": {
            "class": {
              "type": "string",
              "enum": ["iron", "wood", "hybrid", "wedge", "putter", "other"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Non-identifying club label, e.g. 7i, driver."
            }
          }
        },
        "strap_fit": {
          "type": "string",
          "enum": ["snug", "normal", "loose"]
        },
        "terrain_lie": {
          "type": "string",
          "enum": [
            "flat",
            "uphill",
            "downhill",
            "sidehill",
            "bunker_edge",
            "other"
          ]
        },
        "session": {
          "type": "object",
          "required": ["session_id", "captured_at_date"],
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque session id (UUID ok)."
            },
            "captured_at_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "UTC calendar date only — no precise location."
            }
          }
        },
        "capture": {
          "type": "object",
          "required": ["path", "sha256", "format"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Relative to manifest dir or absolute path."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format": {
              "type": "string",
              "enum": ["packed_v2", "json_v1"]
            }
          }
        },
        "reference": {
          "type": "object",
          "required": ["impact_timestamp_source", "impact_timestamp_s"],
          "additionalProperties": false,
          "description": "impact_timestamp_s is capture-relative seconds. Device-derived sources (collision_accel/kinematic) are provenance only — not independent gold for Impact/path claims.",
          "properties": {
            "impact_timestamp_source": {
              "type": "string",
              "enum": [
                "collision_accel",
                "kinematic",
                "slow_mo_aligned",
                "optical_aligned",
                "launch_monitor",
                "metronome_aligned",
                "manual"
              ]
            },
            "impact_timestamp_s": {
              "type": "number",
              "minimum": 0,
              "description": "Capture-relative impact time in seconds."
            },
            "slow_mo": { "$ref": "#/$defs/ref_block_slow_mo" },
            "optical": { "$ref": "#/$defs/ref_block_optical" },
            "launch_monitor": { "$ref": "#/$defs/ref_block_launch_monitor" },
            "metronome": { "$ref": "#/$defs/ref_block_metronome" }
          }
        },
        "consent": {
          "type": "object",
          "required": ["obtained", "license"],
          "additionalProperties": false,
          "properties": {
            "obtained": { "type": "boolean" },
            "license": {
              "type": "string",
              "minLength": 1,
              "description": "Internal license tag, e.g. internal-research-v1."
            },
            "notes": { "type": "string" }
          }
        },
        "evidence_class": {
          "type": "string",
          "enum": ["real_device", "synthetic_fixture", "algorithm_synth"],
          "description": "Only real_device counts toward commercial_ready."
        }
      }
    }
  }
}
